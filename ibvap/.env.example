# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (Step 34) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibvap
POSTGRES_USER=ibvap_user
POSTGRES_PASSWORD=change_me

# --- Security (Step 35) ---
JWT_SECRET_KEY=change_me_to_a_real_rs256_private_key_path_or_secret
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Blockchain (Step 36) ---
HYPERLEDGER_NETWORK_CONFIG_PATH=./config/fabric-network.yaml
HYPERLEDGER_CHANNEL_NAME=ibvap-channel
HYPERLEDGER_CHAINCODE_NAME=ibvap-evidence

# --- Deployment mode (Step 47) ---
DEPLOYMENT_MODE=central   # central | edge

# --- Data residency (Step 38) ---
DEPLOYMENT_REGION=IN
